# Env file for `docker compose -f infra/lens/docker-compose.yml`.
# Docker Compose requires this file to sit next to the compose file, so it is
# intentionally separate from the app's single root .env.
#
# Generate secrets with: openssl rand -hex 32

PUBLIC_APP_URL=http://localhost
WEB_ORIGIN=http://localhost
WEB_PORT=80

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
INGESTION_KEY_PEPPER=
