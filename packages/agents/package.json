{
  "name": "@apeii-5/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ingest": "node --env-file-if-exists=../../.env --import tsx src/cli/ingest.ts data",
    "ingest:eval": "node --env-file-if-exists=../../.env --import tsx src/cli/ingest.ts eval",
    "eval:correctness": "node --env-file-if-exists=../../.env --import tsx src/evals/correctness.ts",
    "eval:answer-relevancy": "node --env-file-if-exists=../../.env --import tsx src/evals/answer-relevancy.ts",
    "eval:contains": "node --env-file-if-exists=../../.env --import tsx src/evals/contains.ts",
    "eval:hadith": "pnpm run eval:correctness && pnpm run eval:answer-relevancy && pnpm run eval:contains"
  },
  "dependencies": {
    "@anvia/core": "^1.16.0",
    "@anvia/lens": "^1.2.4",
    "@anvia/openai": "^1.3.2",
    "@anvia/qdrant": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
